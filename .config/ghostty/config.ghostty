custom-shader = ~/.config/ghostty/shaders/cursor-trail.glsl
config-file = ?auto/theme.ghostty
font-family="0xProto Nerd Font"
font-size=16
font-feature = +ss01 
macos-icon = retro 
fullscreen = true
window-padding-x = 1
window-padding-y = 1
window-padding-balance = true
keybind = global:cmd+backquote=toggle_quick_terminal
