# custom shader
custom-shader = ~/.config/ghostty/shaders/cursor-trail.glsl
# custom-shader = ~/.config/ghostty/shaders/glow.glsl
config-file = ?auto/theme.ghostty
# custom app icon
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/icons/catppuccin-mocha.icns
# window padding
window-padding-balance = true
window-padding-x = 1
window-padding-y = 1
fullscreen = true
adjust-cell-height = -16%
# font configurations
font-family="0xProto Nerd Font"
font-size=16
font-feature = +ss01
# custom keybindings
keybind = global:cmd+backquote=toggle_quick_terminal
